# --- Supabase (Project Settings → API) ---
# Públicas: pueden llegar al navegador. La seguridad la garantiza la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETA: solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Aplicación ---
# URL pública principal (para enlaces de recuperación de contraseña y QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dominio que se usa como identificador interno de las cuentas de cliente
# (inicio de sesión por teléfono). No necesita buzón de correo.
CUSTOMER_AUTH_EMAIL_DOMAIN=clientes.webya.app
# Dominio raíz para subdominios por negocio: cafeaurora.<ROOT_DOMAIN>
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
